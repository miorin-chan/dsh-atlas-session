{
  "name": "@miorin/dsh-atlas-session",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "A modular program for differentiable, continuous improvement of the session experience.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "session",
    "aggregate"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "cordis.patch.yml",
    "scripts/dsh-aggregate.mjs",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ja.md",
    "README.pt.md",
    "README.ru.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "scripts": {
    "build:tools": "node --input-type=module -e \"import { existsSync } from 'node:fs'; const entry = './scripts/aggregate/build.mts'; if (existsSync(entry)) await import(entry)\" --",
    "build": "npm run --silent build:tools && node scripts/dsh-aggregate.mjs generate .",
    "aggregate": "npm run build",
    "prepare": "npm run build 1>&2",
    "test": "npm run build && npm run check",
    "check": "npm run --silent build:tools -- --check && node scripts/dsh-aggregate.mjs check .",
    "prepublishOnly": "npm run --silent build:tools 1>&2 && node scripts/dsh-aggregate.mjs verify-release . 1>&2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "plugins": [
        "@miorin/dsh-next-actions",
        "@miorin/dsh-session-caesura",
        "@miorin/dsh-preset-switch",
        "@miorin/dsh-session-sounds",
        "@miorin/dsh-session-title-history",
        "@miorin/dsh-session-rewind",
        "@miorin/dsh-message-translate",
        "@miorin/dsh-composer-queue-indicator"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-next-actions": "0.1.0",
    "@miorin/dsh-session-caesura": "0.1.0",
    "@miorin/dsh-preset-switch": "0.1.0",
    "@miorin/dsh-session-sounds": "0.1.0",
    "@miorin/dsh-session-title-history": "0.1.0",
    "@miorin/dsh-session-rewind": "link:../dsh-session-rewind",
    "@miorin/dsh-message-translate": "link:../dsh-message-translate",
    "@miorin/dsh-composer-queue-indicator": "link:../dsh-composer-queue-indicator"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
