{
  "name": "@miorin/dsh-atlas-session",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Next actions, private closing notes, Agent preset switching in idle sessions, session sounds on macOS, session title history, conversation rewind, message translation, an indicator for queued sends, and automatic pinning of new sessions.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "session",
    "aggregate"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ja.md",
    "README.pt.md",
    "README.ru.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5",
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build:tools": "tsc -p tsconfig.tools.json",
    "build": "dsh-aggregate generate . && npm run build:tools && node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "node --test",
    "test": "npm run build && npm run check",
    "check": "dsh-aggregate check . && npm run build:tools && npm run test:unit && npm run typecheck && node scripts/build.mjs --check && node scripts/sync-types.mjs --check",
    "prepublishOnly": "dsh-aggregate verify-release . && npm run build"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@miorin/dsh-aggregate": "link:../../packages/dsh-aggregate",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "version": 1,
      "runtimeRowId": "dsh-atlas-session",
      "plugins": [
        "@miorin/dsh-next-actions",
        "@miorin/dsh-session-caesura",
        "@miorin/dsh-preset-switch",
        "@miorin/dsh-session-sounds",
        "@miorin/dsh-session-title-history",
        "@miorin/dsh-session-rewind",
        "@miorin/dsh-message-translate",
        "@miorin/dsh-composer-queue-indicator",
        "@miorin/dsh-auto-pin-session"
      ],
      "defaults": {
        "@miorin/dsh-next-actions": true,
        "@miorin/dsh-session-caesura": true,
        "@miorin/dsh-preset-switch": true,
        "@miorin/dsh-session-sounds": true,
        "@miorin/dsh-session-title-history": true,
        "@miorin/dsh-session-rewind": true,
        "@miorin/dsh-message-translate": true,
        "@miorin/dsh-composer-queue-indicator": true,
        "@miorin/dsh-auto-pin-session": true
      }
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-next-actions": "0.1.9",
    "@miorin/dsh-session-caesura": "0.1.1",
    "@miorin/dsh-preset-switch": "0.1.1",
    "@miorin/dsh-session-sounds": "0.1.1",
    "@miorin/dsh-session-title-history": "0.1.1",
    "@miorin/dsh-session-rewind": "0.1.0",
    "@miorin/dsh-message-translate": "0.1.0",
    "@miorin/dsh-composer-queue-indicator": "0.1.0",
    "@miorin/dsh-auto-pin-session": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miorin-chan/dsh-atlas-session.git"
  },
  "homepage": "https://github.com/miorin-chan/dsh-atlas-session#readme",
  "bugs": {
    "url": "https://github.com/miorin-chan/dsh-atlas-session/issues"
  }
}
