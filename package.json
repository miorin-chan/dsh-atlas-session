{
  "name": "@miorin/dsh-atlas-session",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "A modular program for differentiable, continuous improvement of the session experience.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "session",
    "aggregate"
  ],
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "aggregate.yml",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "README.de.md",
    "README.es.md",
    "README.fr.md",
    "README.ja.md",
    "README.pt.md",
    "README.ru.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md"
  ],
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "scripts": {
    "aggregate": "node ../../tools/dsh-aggregate/cli.mjs generate .",
    "check": "node ../../tools/dsh-aggregate/cli.mjs check .",
    "prepack": "node ../../tools/dsh-aggregate/cli.mjs check ."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "aggregate": {
      "plugins": [
        "@miorin/dsh-next-actions",
        "@miorin/dsh-session-caesura",
        "@miorin/dsh-preset-switch",
        "@miorin/dsh-session-sounds",
        "@miorin/dsh-session-title-history"
      ]
    }
  },
  "dependencies": {
    "@miorin/dsh-next-actions": "0.1.0",
    "@miorin/dsh-session-caesura": "0.1.0",
    "@miorin/dsh-preset-switch": "0.1.0",
    "@miorin/dsh-session-sounds": "0.1.0",
    "@miorin/dsh-session-title-history": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
